server:
  port: 8080

spring:
  application:
    name: api-gateway

  cloud:
    config:
      enabled: false   # 🔥 disable config server for now

    gateway:
      routes:
        - id: appointment-service
          uri: lb://appointment-service
          predicates:
            - Path=/appointments/**

        - id: doctor-service
          uri: lb://doctor-service
          predicates:
            - Path=/doctors/**

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka